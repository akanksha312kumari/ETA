# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=sqlite:///./sih_eta.db

# API Settings
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# RailRadar Live Train Data API Key (Backend Only)
RAILRADAR_API_KEY=your_railradar_api_key_here

# OpenWeather API Key (Backend Only)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Kafka Streaming Settings (Placeholder)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_LOCATION_UPDATES=rtis_location_updates
